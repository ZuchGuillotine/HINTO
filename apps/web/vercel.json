{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node inject-config.mjs",
  "outputDirectory": "src",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/vote", "destination": "/index.html" },
    { "source": "/vote/:code", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/legal/privacy.html" },
    { "source": "/terms", "destination": "/legal/terms.html" },
    { "source": "/support", "destination": "/legal/support.html" },
    { "source": "/data-deletion", "destination": "/legal/data-deletion.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
