# HINTO API environment
# Copy to `.env` at the repo root for local development. The API loads it automatically.
# Never commit a real `.env`.

# --- Required ---------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
# PaaS hosts set PORT; API_PORT overrides it when both are present.
PORT=3000
# API_HOST defaults to 127.0.0.1 in development and 0.0.0.0 in production.
# API_HOST=0.0.0.0
API_LOG_LEVEL=info
# Comma separated exact origins. Required (no wildcard) in production.
API_CORS_ALLOW_ORIGIN=http://127.0.0.1:3001,http://localhost:3001
# Used for invite links and the production CORS default.
PUBLIC_WEB_BASE_URL=https://hinto.app
PUBLIC_API_BASE_URL=https://api.hinto.app

# --- Local development only -------------------------------------------------
# Enables POST /v1/dev/session and `Bearer dev-session:<profileId>` impersonation.
# The server refuses to start if this is set together with NODE_ENV=production.
API_ENABLE_DEV_AUTH=true

# --- AI coach ---------------------------------------------------------------
# Leave empty to ship without the coach; clients read `capabilities.canUseAiCoach`.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_MESSAGE_LIMIT_FREE=20
AI_DAILY_MESSAGE_LIMIT_PREMIUM=200

# --- Custom OAuth providers (Snapchat, TikTok) -------------------------------
# Apple and Facebook are configured in the Supabase dashboard, not here.
AUTH_STATE_SECRET=
# Exact URIs or prefixes ending in `*` that provider callbacks may redirect to.
AUTH_ALLOWED_REDIRECT_URIS=hinto://auth/callback,http://127.0.0.1:3001/auth/*
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.hinto.app/v1/auth/providers/tiktok/callback
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REDIRECT_URI=https://api.hinto.app/v1/auth/providers/snapchat/callback
