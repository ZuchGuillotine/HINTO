# HINTO API environment. Copy to `.env` at the repo root for local work; the API
# loads it automatically. Never commit a real `.env`. Production values live in
# AWS Secrets Manager / SSM and are injected into the ECS task definition.

# --- Core runtime -----------------------------------------------------------
NODE_ENV=development
API_HOST=127.0.0.1            # 0.0.0.0 in the container and for physical-device testing
API_PORT=3000
API_LOG_LEVEL=info
API_CORS_ALLOW_ORIGIN=http://127.0.0.1:3001,http://localhost:3001   # https://hnnt.app in production
WEB_APP_URL=http://localhost:3001

# --- Database (RDS Postgres; required in production) ------------------------
# Local: SSM tunnel to staging RDS, see docs/Operational_Readiness_Checklist.md
DATABASE_URL=postgres://user:pass@127.0.0.1:15432/hinto?sslmode=require

# --- Session secrets (required in production) -------------------------------
JWT_ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_PEPPER=
AUTH_STATE_SECRET=            # required for Snapchat/TikTok/Meta OAuth state

# --- Local development only (the server refuses these in production) --------
ENABLE_DEVELOPMENT_AUTH=false
DISABLE_EMAIL_OTP_DELIVERY=false

# --- AWS integrations --------------------------------------------------------
AWS_REGION=us-west-2
S3_MEDIA_BUCKET=              # unset => uploads go to .hinto-media/ locally
CLOUDFRONT_MEDIA_DOMAIN=
SES_FROM_EMAIL=               # verified SES sender; unset => email OTP returns 503

# --- Apple Sign in (native) --------------------------------------------------
APPLE_CLIENT_ID=app.hnnt
APPLE_TEAM_ID=432862NB9P
APPLE_KEY_ID=U5L7DR4AND
APPLE_PRIVATE_KEY=            # or APPLE_PRIVATE_KEY_FILE=path/to/AuthKey.p8 (never commit)

# --- AI coach ----------------------------------------------------------------
OPENAI_API_KEY=               # unset => coach replies with a "not configured" message

# --- Other providers ---------------------------------------------------------
META_CLIENT_ID=
META_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REDIRECT_URI=
